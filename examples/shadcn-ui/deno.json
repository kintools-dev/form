{
  "tasks": {
    "dev": "deno run -A npm:vite --port=5557",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "serve": "deno run --allow-net --allow-read jsr:@std/http@1/file-server dist/"
  },
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react"
  },
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.2",
    "@radix-ui/react-checkbox": "npm:@radix-ui/react-checkbox@^1.3.11",
    "@radix-ui/react-label": "npm:@radix-ui/react-label@^2.1.15",
    "@radix-ui/react-select": "npm:@radix-ui/react-select@^2.3.7",
    "@radix-ui/react-separator": "npm:@radix-ui/react-separator@^1.1.15",
    "@radix-ui/react-slot": "npm:@radix-ui/react-slot@^1.3.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.2",
    "@types/react": "npm:@types/react@^19.2.14",
    "@types/react-dom": "npm:@types/react-dom@^19.2.3",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.0.1",
    "class-variance-authority": "npm:class-variance-authority@^0.7.1",
    "clsx": "npm:clsx@^2.1.1",
    "lucide-react": "npm:lucide-react@^1.41.0",
    "react": "npm:react@^19.2.4",
    "react-dom": "npm:react-dom@^19.2.4",
    "tailwind-merge": "npm:tailwind-merge@^3.6.0",
    "tailwindcss": "npm:tailwindcss@^4.3.2",
    "vite": "npm:vite@^8.0.3"
  }
}
